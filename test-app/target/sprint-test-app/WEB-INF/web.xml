<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee https://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Sprint Test App</display-name>
    <context-param>
        <param-name>controller-package</param-name>
        <param-value>com.sprint.testapp.controller</param-value>
    </context-param>
    <context-param>
        <param-name>upload.path</param-name>
        <param-value>D:/Sprint_Mr_Naina/uploads</param-value>
    </context-param>
    <context-param>
        <param-name>session.timeout</param-name>
        <param-value>1800</param-value>
    </context-param>
    <context-param>
        <param-name>auth.session-key</param-name>
        <param-value>utilisateur</param-value>
    </context-param>
    <listener>
        <listener-class>com.sprint.framework.FrontControllerListener</listener-class>
    </listener>
    <servlet>
        <servlet-name>FrontController</servlet-name>
        <servlet-class>com.sprint.framework.FrontController</servlet-class>
        <init-param>
            <param-name>controller-package</param-name>
            <param-value>com.sprint.testapp.controller</param-value>
        </init-param>
        <init-param>
            <param-name>auth.session-key</param-name>
            <param-value>utilisateur</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>FrontController</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>
</web-app>